<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <!-- CI hygiene fix (2026-07-27) — see XGArcade.Data.csproj's matching
         comment: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 only floors
         Microsoft.EntityFrameworkCore.Relational at 10.0.4, so it must be
         pinned explicitly here too or NuGet settles on that floor instead of
         the 10.0.10 this project actually builds against (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <ProjectReference Include="..\XGArcade.Core\XGArcade.Core.csproj" />
    <!-- COMP-06 (Data.PlayerStore) repositories and COMP-07's Wikidata
         lookup service — boundary rule 1: Games.XGGrid reaches player/
         category data only through these interfaces, never a DbContext
         directly. -->
    <ProjectReference Include="..\XGArcade.Data\XGArcade.Data.csproj" />
    <ProjectReference Include="..\XGArcade.DataSync\XGArcade.DataSync.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
