<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- IGameModule and its supporting types (GameInstance, RoundConfig,
         ScoreResult, CellCategoryTypes, WrongGuessPlayerInfo,
         PredictionSubmission) live in XGArcade.Core. -->
    <ProjectReference Include="..\XGArcade.Core\XGArcade.Core.csproj" />
    <!-- ADR-0096: COMP-15's own persistence
         (IPredictInstanceRepository/PredictTemplate/PredictInstance/
         PredictMatch/PredictMatchPrediction) — boundary rule 1: Games.XGPredict
         reaches its own data only through this interface, never a DbContext
         directly. Same precedent as Games.XGPath's own reference to
         XGArcade.Data. -->
    <ProjectReference Include="..\XGArcade.Data\XGArcade.Data.csproj" />
    <!-- ADR-0099: IFootballDataClient (GenerateInstanceAsync's fixture-list
         fetch, REQ-1301). -->
    <ProjectReference Include="..\XGArcade.DataSync\XGArcade.DataSync.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
