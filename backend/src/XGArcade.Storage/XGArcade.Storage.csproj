<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- IAvatarStorage (the contract this project implements) lives in
         XGArcade.Core/Storage — see that interface's own doc comment and
         ADR-0087 for why the concrete Supabase Storage client lives in its
         own project instead of XGArcade.Core (ADR-0004's hosting-agnostic
         boundary) or XGArcade.Api (never holds a provider-specific HTTP
         client directly). -->
    <ProjectReference Include="..\XGArcade.Core\XGArcade.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
