<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- ADR-0014: Round/IRoundRepository (COMP-03's own persistence) live in
         XGArcade.Data alongside every other entity/repository, regardless of
         which component conceptually owns them. Core.Rounds (this project)
         reaches Round only through IRoundRepository, never a DbContext
         directly (same boundary-enforcement-via-repository-interface pattern
         Games.XGGrid already uses against XGArcade.Data). -->
    <ProjectReference Include="..\XGArcade.Data\XGArcade.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- REQ-904/ADR-0066: CachedIncidentIssueSummaryProvider's IMemoryCache
         dependency — a standard Microsoft.Extensions.* package (ships
         alongside .NET, not a new third-party dependency), pinned to match
         this project's net10.0 target the same way XGArcade.Api/
         XGArcade.Data pin their EF Core packages to 10.0.10 rather than
         letting NuGet resolve a lower transitive floor. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
