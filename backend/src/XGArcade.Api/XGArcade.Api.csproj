<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XGArcade.Core\XGArcade.Core.csproj" />
    <ProjectReference Include="..\XGArcade.Data\XGArcade.Data.csproj" />
    <ProjectReference Include="..\XGArcade.Games.XGGrid\XGArcade.Games.XGGrid.csproj" />
    <ProjectReference Include="..\XGArcade.Games.XGPath\XGArcade.Games.XGPath.csproj" />
    <ProjectReference Include="..\XGArcade.DataSync\XGArcade.DataSync.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to match XGArcade.Data's version explicitly (Program.cs calls
         AddDbContext/UseNpgsql directly) — avoids NuGet resolving a lower
         transitive floor for this project than what XGArcade.Data itself
         builds against. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- CI hygiene fix (2026-07-27) — see XGArcade.Data.csproj's matching
         comment: Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 only floors
         Microsoft.EntityFrameworkCore.Relational at 10.0.4, so it must be
         pinned explicitly here too or NuGet settles on that floor instead of
         the 10.0.10 this project actually builds against (MSB3277). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- JWT validation middleware (REQ-606's pipeline, ADR-0004: auth
         delegated to Supabase Auth, backend validates JWTs only). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

</Project>
