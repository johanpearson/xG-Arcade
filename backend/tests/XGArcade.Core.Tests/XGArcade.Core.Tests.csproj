<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <!-- S-008: RoundGenerationServiceTests/RoundCloseServiceTests follow this
         repo's no-mocking-framework pattern (docs/coding-guidelines.md) —
         real, InMemory-backed RoundRepository, same setup
         XGArcade.Games.XGGrid.Tests/GridGameModuleTests.cs already uses. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XGArcade.Core\XGArcade.Core.csproj" />
    <!-- Transitively available via XGArcade.Core (ADR-0014), referenced
         directly for the same reason XGArcade.Games.XGGrid.Tests references
         XGArcade.Data directly: real repository/DbContext instances, not
         just the interface types. -->
    <ProjectReference Include="..\..\src\XGArcade.Data\XGArcade.Data.csproj" />
    <ProjectReference Include="..\XGArcade.TestSupport\XGArcade.TestSupport.csproj" />
    <!-- REQ-710/S-201 (quality-gate fix): AccountDeletionServiceTests
         constructs a real XGPredictGameModule (backed by the real,
         InMemory PredictInstanceRepository already referenced above) so its
         two existing DB-assertion tests keep proving actual
         anonymize/hard-delete behavior through IGameModule.PurgeUserDataAsync,
         not just that the method was called. xG Grid/xG Path use the
         existing FakeGameModule (XGArcade.Core.Tests/Rounds/FakeGameModule.cs)
         instead of a real GridGameModule/XGPathGameModule for that same
         slot — both are genuine no-ops for PurgeUserDataAsync, and pulling
         in Games.XGGrid/Games.XGPath here would also require duplicating
         their Wikidata/football-data test fakes (which are private to
         their own test projects), for zero behavioral difference in this
         test class. -->
    <ProjectReference Include="..\..\src\XGArcade.Games.XGPredict\XGArcade.Games.XGPredict.csproj" />
    <!-- NeverCalledFootballDataClient (Auth/AccountDeletionServiceTests.cs)
         implements IFootballDataClient directly, same "not just the
         transitive reference" reasoning XGArcade.Games.XGPredict.Tests'
         own .csproj comment gives for its identical reference. -->
    <ProjectReference Include="..\..\src\XGArcade.DataSync\XGArcade.DataSync.csproj" />
  </ItemGroup>

</Project>
